{
  "name": "maturitni-procvicovani",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "start:server": "node server/index.mjs",
    "db:migrate": "node server/setup.mjs",
    "db:seed": "node server/setup.mjs --seed",
    "test": "node --test server/tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/start.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "sass-embedded": "^1.107.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
