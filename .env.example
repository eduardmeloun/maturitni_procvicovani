# Copy to .env. API/startup and database commands load it automatically.
# Existing environment variables take precedence.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# DATABASE_PATH=data/app.sqlite
# npm start uses production mode. Set APP_ORIGIN to the public HTTPS origin.
# Production requires an actual email delivery service:
# RESET_WEBHOOK_URL=https://your-mail-service.example/reset
# RESET_WEBHOOK_SECRET=replace-with-a-secret
